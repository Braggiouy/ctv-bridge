{
  appId: "com.ctv.bridge",
  productName: "CTV Bridge",
  publish: {
    provider: "github",
    owner: "Braggiouy",
    repo: "ctv-bridge",
  },
  directories: {
    output: "release/${version}",
  },
  artifactName: "${name}-${version}-${arch}.${ext}",
  files: [
    "dist",
    "dist-electron",
    "!dist/**/*.map", // Exclude source maps
    "!dist-electron/**/*.map",
  ],
  // Exclude unnecessary files from all builds
  asarUnpack: [],
  extraResources: [],
  compression: "maximum", // Enable maximum compression
  icon: "build/icon.png", // 1024x1024; converted to .icns/.ico per platform
  mac: {
    target: ["dmg"], // Only DMG (most common for Mac)
    category: "public.app-category.developer-tools",
    // Ad-hoc sign the whole bundle so it gets a stable com.ctv.bridge identity instead of
    // Electron's linker signature; macOS Local Network privacy keys off this (EHOSTUNREACH otherwise).
    identity: "-",
    hardenedRuntime: false,
    extendInfo: {
      NSLocalNetworkUsageDescription: "CTV Bridge connects to TVs on your local network to install and debug apps.",
    },
    artifactName: "${name}-${version}-${arch}.${ext}",
  },
  dmg: {
    writeUpdateInfo: true,
  },
  win: {
    target: ["nsis"], // Only NSIS installer (most common for Windows)
    artifactName: "${name}-${version}.${ext}",
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    artifactName: "${name}-${version}-setup.${ext}",
  },
  linux: {
    target: ["AppImage"], // Only AppImage (most portable for Linux)
    category: "Development",
    artifactName: "${name}-${version}-${arch}.${ext}",
  },
}
